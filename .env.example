# Copy to .env and fill real values
# Use either DATABASE_URL (preferred) or DB_* variables
DATABASE_URL=
DB_NAME=sports_db
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Football-data API key (get from https://www.football-data.org/)
# Set this in your environment or in a local `.env` file. Do NOT commit real keys.
FOOTBALL_API_KEY=
